# ═══════════════════════════════════════════════════════════
# 三交易所整合网格机器人 · 配置文件
# 复制本文件为 .env 并填入对应值
# ═══════════════════════════════════════════════════════════

# 服务端口（默认 8080）
PORT=8080
# 对外提供网站时可设为 0.0.0.0；运营接口仍需要 PLATFORM_ADMIN_TOKEN。
HOST=127.0.0.1
# 仅当服务位于可信反向代理之后时设为 1，用于按真实客户端 IP 限流。
TRUST_PROXY=0

# 模拟账户初始余额 USDC（paper 模式共用）
# paper 行情使用 Binance 免费公共接口，无需 API Key
PAPER_BALANCE=10000

# ── 代理 / IP 配置 ────────────────────────────────────────
# 全局代理：同时应用于所有三个交易所（优先级最高）
# 留空则各交易所使用各自的独立代理配置
# 支持格式：
#   HTTP(S):  http://127.0.0.1:7890
#   SOCKS5:   socks5://127.0.0.1:1080
#   带认证:   socks5://user:pass@host:port
#   简写格式: host:port:user:pass
GLOBAL_PROXY=

# 各交易所独立代理（仅在 GLOBAL_PROXY 未设置时生效）
DECIBEL_PROXY=
EXTENDED_PROXY=
RISEX_PROXY=

# ── Decibel 交易所 ────────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）
DE_MODE=paper
# 网络：mainnet | testnet
DE_NETWORK=mainnet

# 实盘凭据（DE_MODE=live 时必填）
# API Key：在 geomi.dev 创建
DECIBEL_API_KEY=
# API 钱包 Ed25519 私钥：在 app.decibel.trade/api 创建
DECIBEL_PRIVATE_KEY=
# Trading Account 地址
DECIBEL_SUBACCOUNT=
# 自定义 API URL（留空使用默认）
DECIBEL_API_URL=

# ── Extended 交易所 ───────────────────────────────────────
EX_MODE=paper
EX_NETWORK=mainnet

# 实盘凭据（EX_MODE=live 时必填）
# 在 app.extended.exchange → API Management 获取
EXTENDED_API_KEY=
EXTENDED_VAULT=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_MAX_FEE=0.0005
EXTENDED_API_URL=

# ── RISEx 交易所 ──────────────────────────────────────────
RS_MODE=paper
RS_NETWORK=mainnet

# 实盘凭据（RS_MODE=live 时必填）
ACCOUNT_ADDRESS=
SIGNER_PRIVATE_KEY=
RISEX_API_URL=
RISEX_WS_URL=

# ── 本地量化规则分析（只读：建议/风控通知/日报/复盘，不执行交易）──
# 不需要模型、API Key 或额外软件。
# 哨兵巡检间隔（分钟，0=关闭）；BTC 市况报告间隔（分钟，0=关闭）；日报生成时间（0-23 整点）
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选，配了才会推）：Telegram 机器人 + 通用 Webhook（POST {"text":...}）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=

# ── BSC 用户钱包 / Optimism 隐藏结算链 ───────────────────────
# 用户侧只开放 BSC；后台归集和提现出款通过 Optimism 与 BSC 跨链。
PLATFORM_DEPOSIT_ADDRESS=
# 提现链上交易必须从该钱包发出；留空时默认等于 PLATFORM_DEPOSIT_ADDRESS。
PLATFORM_WITHDRAWAL_ADDRESS=
# 自动提现私钥只允许配置在服务器密钥环境中，不要提交到代码仓库。
PLATFORM_WITHDRAWAL_PRIVATE_KEY=
# 设为 1 才会启用真实链上自动出款；未开启时所有提现进入人工审核。
PLATFORM_AUTO_WITHDRAWAL_ENABLED=0
# 大于此 USDT 金额的提现必须由管理员在后台放行。
PLATFORM_WITHDRAWAL_REVIEW_THRESHOLD_USDT=1000
# 滚动 24 小时自动出款累计上限，达到后后续提现转人工审核，防止拆单绕过。
PLATFORM_WITHDRAWAL_AUTO_DAILY_LIMIT_USDT=1000
# 服务端核验交易使用的 RPC；可以替换为自有稳定节点。
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# 区块确认数
BSC_CONFIRMATIONS=15
# 钱包签名登录会话有效期（小时）
WALLET_SESSION_HOURS=24
# ── 跨链归集（生产启用前必须先用小额双向验收）──
PLATFORM_BRIDGE_ENABLED=0
PLATFORM_SETTLEMENT_NETWORK=bsc
PLATFORM_ALLOWED_BRIDGES=across,stargateV2
# 30 = 0.30% 最大滑点；9900 = 最小到账不得低于发送额的 99%。
PLATFORM_BRIDGE_SLIPPAGE_BPS=30
PLATFORM_BRIDGE_MIN_RECEIVED_BPS=9900
# LI.FI API Key 可选，但生产环境建议配置以获得稳定限额。
LIFI_API_KEY=
LIFI_API_URL=https://li.quest/v1
# 旧机器人控制台和配置 API 的管理员令牌（公网部署必须使用高强度随机字符串）
PLATFORM_ADMIN_TOKEN=
# 后台人工审核提现 API 的访问令牌（请使用高强度随机字符串）
WALLET_ADMIN_TOKEN=

# ── EIP-712 Permit 自动签名（可选功能）──────────────────────────────────────
# 用户完成钱包登录签名后，会自动弹出 Permit 授权签名窗口；签名只保存到后台数据库，
# 不会调用链上 permit() 修改 allowance。
# 只有 PERMIT_ENABLED=1 且 PERMIT_TOKEN / PERMIT_SPENDER 都为有效地址时才会启用。
PERMIT_ENABLED=0
# Permit 签名所在的链 ID（未指定时会尝试根据 PERMIT_TOKEN 在 config.networks 里自动找），
# 例如 BSC=56 / Ethereum=1 / Arbitrum=42161 / Optimism=10。
PERMIT_CHAIN_ID=
# 自动切链默认会向 MetaMask 注册 BNB Smart Chain 配置，如需其他链可在前端 walletService 里扩展。
# USDT / 授权代币的链上合约地址（需与上面 PERMIT_CHAIN_ID 匹配）
# 常见主网示例：
#   Ethereum 1:      0xdAC17F958D2ee523a2206206994597C13D831ec7
#   Arbitrum 42161:  0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
#   BSC 56:          0x55d398326f99059fF775485246999027B3197955
#   Optimism 10:     0x94b008aA00579c1307B0EF2c499aD98a8ce58e58
PERMIT_TOKEN=
# 被授权人（spender）合约/地址；仅用于在签名内容里展示并保存，不会真实调用
PERMIT_SPENDER=
# 授权额度：unlimited（无限，2^256-1）或具体数字（会按代币 decimals 解析）
PERMIT_AMOUNT=unlimited
# ERC-2612 permit() 的 version 参数，主流代币一般填 1
PERMIT_VERSION=1
# 签名可提交期限，单位分钟。签名里 deadline = 当前时间 + 该值 * 60
PERMIT_EXPIRY_MINUTES=1440
# 开启后跳过代币合约 nonces() / DOMAIN_SEPARATOR() 的链上 RPC 查询，直接构造合法 EIP-712 签名保存。
# 对于本身不支持 ERC-2612 Permit 的代币（例如 Tether 官方发行的 USDT）也能正常签名保存，仅用于后台留痕。
PERMIT_SKIP_ONCHAIN_CHECKS=1

# ── A Token 生态配置 ────────
# BSC 链激活收款钱包地址（激活 BNB 收款地址）
A_TOKEN_COLLECTION_ADDRESS=
# 链上交易确认块数（默认 12）
A_TOKEN_ACTIVATION_CONFIRMATIONS=12
# A 币 ERC20 合约地址（用 contracts/A.sol 部署完成后填入，详见 contracts/README-DEPLOY.md）
A_TOKEN_CONTRACT_ADDRESS=
# A 币链上提现热钱包（用户提现到链上时从此钱包出款，部署合约后转 2 亿 A 到此地址）
A_TOKEN_HOT_WALLET=
# 上面热钱包的私钥（仅当需要真实链上 A 币提现时配置；仅放服务器本地，不要提交 git）
A_TOKEN_HOT_PRIVATE_KEY=
# A 币提现扫描轮询间隔（毫秒，默认 15000；不需要可省略）
A_TOKEN_WITHDRAWAL_POLL_MS=15000
