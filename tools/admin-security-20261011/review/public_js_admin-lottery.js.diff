+  function safeScreenshot(value) {
+    if (typeof value !== 'string' || value.length > 950000) return null;
+    const match = /^data:image\/(png|jpeg|jpg|webp|gif);base64,([A-Za-z0-9+/]+={0,2})$/i.exec(value);
+    if (!match) return null;
+    try {
+      const bytes = atob(match[2]);
+      if (!bytes || btoa(bytes) !== match[2]) return null;
+      const kind = match[1].toLowerCase();
+      const valid = kind === 'png' ? bytes.startsWith('\x89PNG\r\n\x1a\n')
+        : ['jpeg','jpg'].includes(kind) ? bytes.startsWith('\xff\xd8\xff')
+        : kind === 'gif' ? ['GIF87a','GIF89a'].includes(bytes.slice(0,6))
+        : bytes.startsWith('RIFF') && bytes.slice(8,12) === 'WEBP';
+      return valid ? value : null;
+    } catch { return null; }
+  }
 
